# Trova — copy to .env.local and fill in. NEVER commit .env.local.

# --- server-only (never exposed to the browser) ---
TOKENS_XYZ_API_KEY=            # app.tokens.xyz -> API Manager
JUPITER_REFERRAL_ACCOUNT=      # referral.jup.ag (optional; add before submit)
JUPITER_REFERRAL_FEE_BPS=30    # 0.30%
SUPABASE_SERVICE_ROLE_KEY=     # optional for MVP (watchlist/drift can stub to localStorage)

# --- public (client-visible; fine to expose) ---
NEXT_PUBLIC_HELIUS_RPC_URL=    # mainnet RPC; add Allowed Origins (localhost + your domain) at deploy
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- cron (server-only; Vercel sends it as a Bearer token to /api/cron/*) ---
CRON_SECRET=
# --- server-side RPC (optional; falls back to NEXT_PUBLIC_HELIUS_RPC_URL) ---
HELIUS_RPC_URL=
