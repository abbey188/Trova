# Trova — copy to .env.local and fill in. NEVER commit .env.local.

# --- server-only (never exposed to the browser) ---
TOKENS_XYZ_API_KEY=            # app.tokens.xyz -> API Manager
JUPITER_REFERRAL_ACCOUNT=      # referral.jup.ag (optional; add before submit)
JUPITER_REFERRAL_FEE_BPS=30    # 0.30%
# Optional. Keyless Jupiter is 0.5 req/s (30 a minute) shared across Swap, Price and Tokens —
# enough to break a demo that measures exit cost for a whole portfolio. A key from
# developers.jup.ag/portal lifts it to 60/min (Free) or 600/min (Developer).
JUPITER_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=     # optional for MVP (watchlist/drift can stub to localStorage)

# --- public (client-visible; fine to expose) ---
NEXT_PUBLIC_HELIUS_RPC_URL=    # mainnet RPC; add Allowed Origins (localhost + your domain) at deploy
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- cron (server-only; Vercel sends it as a Bearer token to /api/cron/*) ---
CRON_SECRET=
# --- server-side RPC: what production uses. Set this as a Vercel SECRET; it never reaches the browser.
#     Only set NEXT_PUBLIC_HELIUS_RPC_URL too once the key has Allowed Origins in Helius, because a
#     NEXT_PUBLIC_ value ships to every visitor. Without it the browser uses the public Solana RPC. ---
HELIUS_RPC_URL=
