{
  "name": "trova",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "verify:scoring": "tsx scripts/verify-scoring.ts",
    "verify:signals": "tsx scripts/verify-signals.ts",
    "verify": "tsx scripts/verify-scoring.ts && tsx scripts/verify-signals.ts",
    "verify:exit": "tsx --env-file=.env.local scripts/verify-exit.ts",
    "measure": "tsx --env-file=.env.local scripts/measure-exit.ts",
    "diagnostics": "tsx --env-file=.env.local scripts/score-diagnostics.ts",
    "snapshot": "tsx --env-file=.env.local scripts/snapshot.ts",
    "snapshot:dry": "tsx --env-file=.env.local scripts/snapshot.ts --dry-run",
    "rescore": "tsx --env-file=.env.local scripts/rescore.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.3",
    "@hugeicons/react": "^1.1.10",
    "@solana/kit": "^8.3.0",
    "@solana/kit-plugin-rpc": "^0.19.0",
    "@solana/kit-plugin-wallet": "^0.20.0",
    "@solana/react": "^8.3.0",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "next": "15.5.28",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.23",
      "source-map-js": "^1.2.2",
      "sharp": "^0.35.5"
    }
  }
}
